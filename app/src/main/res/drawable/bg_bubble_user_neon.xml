<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-2dp" android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#30FF5BE8"/>
            <corners android:topLeftRadius="20dp" android:topRightRadius="6dp" android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#D0A02A98" android:endColor="#D0481560"/>
            <stroke android:width="1.5dp" android:color="#FFFF7AEA"/>
            <corners android:topLeftRadius="18dp" android:topRightRadius="4dp" android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp"/>
        </shape>
    </item>
</layer-list>
