<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#66FFFFFF">
    <item>
        <layer-list>
            <item android:top="-3dp" android:bottom="-3dp" android:left="-3dp" android:right="-3dp">
                <shape android:shape="rectangle">
                    <stroke android:width="6dp" android:color="#4025D366"/>
                    <corners android:radius="30dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#FF25D366" android:endColor="#FF0E8F6E"/>
                    <stroke android:width="1.5dp" android:color="#FFCFFFE3"/>
                    <corners android:radius="28dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
