        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F02A0838" android:endColor="#F00E0016"/>
            <stroke android:width="2dp" android:color="#FFFF5BE0"/>
            <corners android:radius="30dp"/>
        </shape>
    </item>
</layer-list>
