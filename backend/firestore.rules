rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An administrator = a signed-in user whose UID has a document in /admins (created by YOU in the console).
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Nobody can create/modify admins from the app or website. Users may only read their own entry (admin check).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /wallpapers/{id} {
      // Apps see PUBLISHED wallpapers only; admins see everything.
      allow read: if resource.data.published == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // anonymous statistics: only downloads/views, only +1, only on published items
        resource.data.published == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads', 'views']) &&
        (!('downloads' in request.resource.data.diff(resource.data).affectedKeys()) ||
           request.resource.data.downloads == resource.data.downloads + 1) &&
        (!('views' in request.resource.data.diff(resource.data).affectedKeys()) ||
           request.resource.data.views == resource.data.views + 1)
      );
    }
  }
}
